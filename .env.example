# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# 이 두 변수만 맞춰도 게스트 기능은 동작하지 않는다.
# PostgREST 노출 스키마에 api 를 추가해야 하고(없으면 PGRST106), 그 설정은 코드에 남지 않는다.
# 재현 절차: docs/product/supabase-project-setup.md

# 공유 링크와 metadataBase 가 쓰는 앱 기준 주소(슬래시 없이). 설정하지 않으면
# VERCEL_URL → localhost:3000 순으로 떨어진다. 커스텀 도메인을 쓰면 반드시 지정해야
# 서버와 클라이언트가 같은 링크를 만든다(지정하지 않으면 hydration 불일치).
# 예) NEXT_PUBLIC_SITE_URL=https://moim.example.com
NEXT_PUBLIC_SITE_URL=
